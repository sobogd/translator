generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Translation {
  id          String   @id @default(cuid())
  mode        String // "audio" | "text"
  sourceLang  String // "ru" | "es"
  transcript  String
  translation String
  audioUrl    String?
  createdAt   DateTime @default(now())

  @@map("translations")
}
