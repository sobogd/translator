generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id           String        @id @default(cuid())
  ownerKey     String // verified Google email, lowercased
  title        String? // null until first translation, then a truncated transcript
  sourceLang   String? // ISO 639-1 code; null = auto-detect pending (locked on first translation)
  targetLang   String // ISO 639-1 code
  lastUsedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@index([ownerKey])
  @@map("topics")
}

model Session {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime? // null = never expires (until logout/cache clear)
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("sessions")
}

// Billing + credits, keyed by the verified Google email (mirrors Chat.ownerKey
// — there is no separate User table). Created lazily on first credit check.
model Account {
  email                String    @id
  plan                 String    @default("FREE") // "FREE" | "STARTER" | "PRO" | "ULTIMATE"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("INACTIVE") // "INACTIVE" | "ACTIVE" | "PAST_DUE" | "CANCELED" | "EXPIRED"
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  creditsBalance       Int       @default(40)
  creditsResetAt       DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("accounts")
}

// One free lifetime credit pool per browser fingerprint, for the unauthenticated
// landing-page translate widget. Not linked to Account/email.
model AnonymousCredit {
  fingerprint String   @id
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("anonymous_credits")
}

// Stripe webhook idempotency: event id checked before processing, written after.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@map("stripe_events")
}

model Translation {
  id          String   @id @default(cuid())
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceLang  String // ISO 639-1 code
  transcript  String
  translation String
  createdAt   DateTime @default(now())

  @@index([topicId])
  @@map("translations")
}
