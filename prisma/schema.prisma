generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id           String        @id @default(cuid())
  ownerKey     String // verified Google email, lowercased
  title        String? // null until first translation, then a truncated transcript
  sourceLang   String? // ISO 639-1 code; null = auto-detect pending (locked on first translation)
  targetLang   String // ISO 639-1 code
  lastUsedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@index([ownerKey])
  @@map("topics")
}

model Session {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime? // null = never expires (until logout/cache clear)
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("sessions")
}

// Billing + credits, keyed by the verified Google email (mirrors Chat.ownerKey
// — there is no separate User table). Created lazily on first credit check.
model Account {
  email                String    @id
  plan                 String    @default("FREE") // "FREE" | "STARTER" | "PRO" | "ULTIMATE"
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("INACTIVE") // "INACTIVE" | "ACTIVE" | "PAST_DUE" | "CANCELED" | "EXPIRED"
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // Quotas (chars of text translation + seconds of STT audio). Without a
  // subscription these hold the lifetime free-trial pool (no refill); on an
  // active plan they refill to the plan's monthly allowance at quotaResetAt.
  charsBalance         Int       @default(4000)
  secondsBalance       Int       @default(120)
  quotaResetAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("accounts")
}

// One free lifetime quota pool per browser fingerprint, for the unauthenticated
// landing-page translate widget. Not linked to Account/email.
model AnonymousCredit {
  fingerprint String   @id
  charsUsed   Int      @default(0)
  secondsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("anonymous_credits")
}

// Stripe webhook idempotency: event id checked before processing, written after.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@map("stripe_events")
}

model Translation {
  id          String   @id @default(cuid())
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceLang  String // ISO 639-1 code
  transcript  String
  translation String
  createdAt   DateTime @default(now())

  @@index([topicId])
  @@map("translations")
}

// ---------------------------------------------------------------------------
// Analytics — cookieless, salt-hashed visits. Ported from iq-rest's
// analytics-v2 pipeline (apps/dashboard-api/src/analytics-v2/**), minus the
// ad-network conversion half: iq-translate runs no advertising.
//
// Nothing is stored on the visitor's device. The key of a visit is
// sha256(dailySalt | ip-prefix | user-agent | entropy) computed server-side,
// and the salt is overwritten once a day, which is what makes yesterday's
// hashes permanently unlinkable. Raw IP and raw user agent are never
// persisted anywhere.
// ---------------------------------------------------------------------------

// Singleton row (id = "current") holding the active hash salt. Rotated daily
// at 04:00 Europe/Madrid; the previous salt is destroyed by the overwrite.
model AnalyticsSalt {
  id        String   @id
  value     String
  rotatedAt DateTime

  @@map("analytics_salt")
}

// One row = one VISIT: a device hash plus an identity, cut after 30 minutes of
// silence. Device/geo/source attribution lives here so event rows stay minimal.
model SessionNew {
  id         String   @id @default(cuid())
  // Dedup key of one visit: sha256(hash | email ?? "" | start-minute). The raw
  // `hash` cannot be unique — two signed-out people behind one NAT with the
  // same UA share it and must not share a visit row once one of them signs in,
  // and the same device starts a NEW visit after 30 minutes of silence. The
  // start-minute bucket makes two racing "start a visit" requests converge on
  // one row instead of inserting two.
  visitKey   String   @unique
  hash       String
  firstAt    DateTime @default(now())
  lastAt     DateTime @default(now())
  device     String? // 'mobile' | 'tablet' | 'desktop'
  os         String? // 'ios' | 'android' | 'windows' | 'macos' | 'linux' | 'other'
  country    String   @default("XX")
  region     String   @default("")
  city       String   @default("")
  lang       String? // full Accept-Language primary tag, e.g. "es-ES"
  theme      String? // 'dark' | 'light' — prefers-color-scheme, first-write-wins
  from       String? // ?from= campaign tag, first-write-wins
  ref        String? // first-touch referrer host (search engines only)
  // Identity of the visit — the verified Google email, which is this app's
  // account key (there is no User table). Stamped as soon as the session
  // cookie resolves, so a visit that starts anonymous is promoted in place and
  // its pre-sign-in events keep their row.
  email      String?
  // How many anonymous rows were folded into this one (same device signed out
  // and back in within a salt-day).
  mergeCount Int      @default(0)

  events EventNew[]

  @@index([firstAt])
  @@index([email])
  // Ingest looks up the LIVE visit for a device hash (lastAt inside the 30-min
  // idle window), so the timestamp belongs in the index; the admin list sorts a
  // 30-day window by lastAt.
  @@index([hash, lastAt])
  @@index([lastAt])
  @@map("sessions_new")
}

// Everything about the device/geo/source lives on the visit; the event row
// carries only what can change between two events of the same visit.
model EventNew {
  id        String   @id @default(cuid())
  sessionId String
  page      String // "Home", "Pair", "Pricing", "Legal", …
  action    String // "Show" | "Click" | "Translate" | "Register" | …
  name      String // "Pageview", "Header sign in", "Text es-en", …
  // Conversation active at the moment of the event. Per-event rather than
  // per-visit because one visit moves between topics.
  topicId   String?
  // Locale the page was rendered in ("es"), as opposed to SessionNew.lang,
  // which is the browser's Accept-Language. Per-event for the same reason as
  // the topic: a visit can cross locales.
  locale    String?
  at        DateTime @default(now())

  session SessionNew @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([page, action, at])
  @@index([topicId, at])
  @@index([at])
  @@map("events_new")
}
