generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chat {
  id           String        @id @default(cuid())
  ownerKey     String // "telegram:<id>" | "device:<uuid>" | "apple:<sub>" ...
  langA        String // ISO 639-1 code, langA < langB lexicographically
  langB        String // ISO 639-1 code
  lastUsedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@unique([ownerKey, langA, langB])
  @@index([ownerKey])
  @@map("chats")
}

model Translation {
  id          String   @id @default(cuid())
  chatId      String?
  chat        Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  mode        String // "audio" | "text"
  sourceLang  String // ISO 639-1 code
  transcript  String
  translation String
  audioUrl    String?
  createdAt   DateTime @default(now())

  @@index([chatId])
  @@map("translations")
}
